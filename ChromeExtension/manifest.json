{
  "manifest_version": 3,
  "name": "AI 사용량 · 웹 연결",
  "version": "1.2.0",
  "description": "Claude · Codex · Gemini 사용량 페이지의 수치를 이 Mac의 메뉴바에 전달합니다.",
  "key": "",
  "permissions": [
    "alarms",
    "nativeMessaging",
    "storage"
  ],
  "host_permissions": [
    "https://gemini.google.com/*",
    "https://claude.ai/*",
    "https://chatgpt.com/*"
  ],
  "background": {
    "service_worker": "worker.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "AI 사용량 웹 연결"
  },
  "content_scripts": [
    {
      "matches": [
        "https://gemini.google.com/usage*",
        "https://gemini.google.com/u/*/usage*"
      ],
      "js": [
        "parser.js",
        "content.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://claude.ai/settings/usage*",
        "https://claude.ai/new*",
        "https://chatgpt.com/settings/usage*"
      ],
      "js": [
        "web-parser.js",
        "web-content.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
